<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net7.0-windows</TargetFrameworks>
    <AssemblyName>GhCopilot.Rhino</AssemblyName>
    <RootNamespace>GhCopilot.Rhino</RootNamespace>
    <TargetExt>.rhp</TargetExt>
    <Version>0.1.0</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GhCopilot.Core\GhCopilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\GhCopilot.Gh\UI\*.cs" Link="UI\%(Filename)%(Extension)" />
    <Compile Include="..\GhCopilot.Gh\Canvas\RhinoViewportInspector.cs" Link="Host\RhinoViewportInspector.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
