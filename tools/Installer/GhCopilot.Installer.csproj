<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>GhCopilot-Setup-0.1.0</AssemblyName>
    <RootNamespace>GhCopilot.Installer</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationTitle>GH Copilot Setup</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\artifacts\ghcopilot-0.1.0-rh8_0-any.yak">
      <LogicalName>Payload.yak</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
