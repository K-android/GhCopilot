<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == ''">C:\Program Files\Rhino 8\System</RhinoSystemDir>
    <ShouldRemoveRhinoReferences Condition="!Exists('$(RhinoSystemDir)\Eto.Wpf.dll')">False</ShouldRemoveRhinoReferences>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Eto" Condition="Exists('$(RhinoSystemDir)\Eto.dll')"><HintPath>$(RhinoSystemDir)\Eto.dll</HintPath></Reference>
    <Reference Include="Eto.Wpf" Condition="Exists('$(RhinoSystemDir)\Eto.Wpf.dll')"><HintPath>$(RhinoSystemDir)\Eto.Wpf.dll</HintPath></Reference>
    <PackageReference Include="RhinoCommon" Version="8.5.24072.13001" Condition="!Exists('$(RhinoSystemDir)\Eto.Wpf.dll')" />
    <PackageReference Include="RhinoWindows" Version="8.5.24072.13001" Condition="!Exists('$(RhinoSystemDir)\Eto.Wpf.dll')" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.4" Condition="!Exists('$(RhinoSystemDir)\Eto.Wpf.dll')" />
    <PackageReference Include="Extended.Wpf.Toolkit" Version="3.8.1" Condition="!Exists('$(RhinoSystemDir)\Eto.Wpf.dll')" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
</Project>